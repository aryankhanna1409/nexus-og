# Aegis-Net configuration. Copy to .env and fill in; .env is git-ignored.
# Never commit real tokens or API keys.

# Database: SQLite for the offline demo, PostgreSQL in Docker.
DATABASE_URL=sqlite:///./data/aegis.db
# DATABASE_URL=postgresql+psycopg://aegis:change-me@postgres:5432/aegis

# API tokens: comma-separated name:role:sha256(token). Generate entries with
#   scripts/hash_token.py <name> <viewer|operator|approver|admin>
AEGIS_API_TOKENS=

# LLM provider: mock (deterministic, offline default) | anthropic | openai | local
LLM_PROVIDER=mock
MODEL_NAME=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenAI-compatible endpoint for LLM_PROVIDER=local (e.g. http://localhost:11434/v1)
LOCAL_LLM_BASE_URL=

# Redis for rate limiting (optional; in-process fallback when unset)
REDIS_URL=
AEGIS_RATE_LIMIT_PER_MINUTE=120
AEGIS_MAX_REQUEST_BYTES=1000000

# DevSecOps agent: HIGH_RISK actions (e.g. production rollback) stay disabled
# unless explicitly enabled here, and still require approval.
AGENT_ALLOW_HIGH_RISK=false
AGENT_WORKSPACE_ROOT=/tmp/aegis-agent-workspaces

LOG_LEVEL=INFO
